{
  "name": "agentflow",
  "version": "1.0.0",
  "description": "Visual AI workflow orchestration platform with an Electron desktop shell",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cappercclove/agentflow.git"
  },
  "keywords": [],
  "author": "cappercclove",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cappercclove/agentflow/issues"
  },
  "homepage": "https://github.com/cappercclove/agentflow#readme",
  "build": {
    "appId": "com.agentflow.desktop",
    "productName": "AgentFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "frontend/**/*",
      "backend/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
