BAILIAN_API_KEY=your-api-key-here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
# 编辑器里的三个档位默认是 qwen-turbo / qwen-plus / qwen-max。专用工作空间端点
# （*.maas.aliyuncs.com）不一定挂着这些公有模型名，报 404 Model not exist 时用它俩改指：
# BAILIAN_MODEL_TURBO=qwen-flash
# BAILIAN_MODEL_MAX=qwen-max
DATABASE_URL=sqlite:///./workflows.db

# ---- 公网部署时才需要，本地/Electron 全部留空即可 ----
# 访问口令。设置后，除 /health 与 /api/login 以外的所有请求都要先带会话 Cookie。
# AGENTFLOW_ACCESS_CODE=
# 会话签名密钥。留空则从访问口令派生（换口令会让所有人重新登录）。
# AGENTFLOW_SESSION_SECRET=
# 前面有 Nginx/Caddy 反代时设为 1，按 X-Forwarded-For 记 IP，否则限流只看到 127.0.0.1。
# AGENTFLOW_TRUST_PROXY=1
# 站点走 HTTPS 时设为 1，Cookie 只在加密连接上发送。
# AGENTFLOW_COOKIE_SECURE=1
# 每小时/每 10 分钟配额，默认值如下。
# AGENTFLOW_LIMIT_LOGIN=10
# AGENTFLOW_LIMIT_EXECUTE=30
# AGENTFLOW_LIMIT_DECOMPOSE=10
# AGENTFLOW_LIMIT_NODE=20
# 全站每天可启动的运行次数。
# AGENTFLOW_DAILY_RUNS=200
